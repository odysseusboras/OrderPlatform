{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Orders": {
    "MaxWaitSeconds": 10
  },
  "Pricing": {
    "ShippingCharge": 5.0,
    "FreeShippingFrom": 100.0
  }
}
